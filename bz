<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Benzodiazepin Kullanım Araştırması Veri Formu</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
            vertical-align: top;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        .section-header {
            background-color: #4A5568;
            color: white;
            font-size: 1.1rem;
        }
        .sub-section-header {
            background-color: #718096;
            color: white;
        }
        input[type="text"], input[type="date"], input[type="number"], select, textarea {
            width: 100%;
            padding: 6px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        .radio-group label, .checkbox-group label {
            margin-right: 15px;
            font-weight: normal;
        }
        #loading-modal, #result-modal {
            display: none; /* Varsayılan olarak gizli */
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.6);
        }
        .modal-content {
            background-color: #fefefe;
            margin: 10% auto;
            padding: 20px;
            border: 1px solid #888;
            width: 80%;
            max-width: 600px;
            border-radius: 8px;
            box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
        }
        .loader {
            border: 8px solid #f3f3f3;
            border-radius: 50%;
            border-top: 8px solid #3498db;
            width: 60px;
            height: 60px;
            animation: spin 2s linear infinite;
            margin: auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-gray-100 p-4 sm:p-6 md:p-8">
    <div class="max-w-full mx-auto bg-white rounded-lg shadow-md overflow-x-auto">
        <h1 class="text-2xl font-bold p-4 bg-gray-700 text-white">Ayaktan Tedavi Gören Çocuk ve Ergen Hastalarda Benzodiazepin Kullanım Alışkanlıkları Veri Giriş Formu</h1>
        <p class="p-4 text-gray-600">Bu interaktif formu doldurduktan sonra, "✨ Yapay Zeka ile Klinik Özet Oluştur" butonuna basarak girilen verilerden otomatik bir klinik not oluşturabilir veya "📋 Formu Gönder" butonu ile yanıtları araştırmacıya iletebilirsiniz.</p>
        
        <!-- FORM BAŞLANGICI - E-POSTA ADRESİ GÜNCELLENDİ -->
        <form id="clinical-form" action="https://formsubmit.co/berfin.g@istanbul.edu.tr" method="POST">
            
            <!-- FormSubmit Ayarları -->
            <input type="hidden" name="_subject" value="Yeni Benzodiazepin Çalışma Formu Yanıtı!">
            <input type="hidden" name="_captcha" value="false"> <!-- İstenmeyen e-postaları önlemek için bunu 'true' yapabilirsiniz -->
            <input type="hidden" name="_template" value="table"> <!-- Yanıtları e-postada tablo olarak formatlar -->


            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <!-- BÖLÜM 1: FORM BİLGİLERİ -->
                    <thead class="bg-gray-50">
                        <tr><th colspan="3" class="section-header">BÖLÜM 1: FORM BİLGİLERİ</th></tr>
                        <tr>
                            <th>1. E-posta</th>
                            <th>2. Formu Dolduran Asistanın Adı Soyadı</th>
                            <th>3. Veri Giriş Tarihi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" id="email" name="E-posta"></td>
                            <td><input type="text" id="asistan_ad_soyad" name="Asistan Adı Soyadı"></td>
                            <td><input type="date" id="veri_giris_tarihi" name="Veri Giriş Tarihi"></td>
                        </tr>
                    </tbody>
                    
                    <!-- BÖLÜM 2: DEMOGRAFİK VE KLİNİK BİLGİLER -->
                    <thead>
                        <tr><th colspan="11" class="section-header">BÖLÜM 2: DEMOGRAFİK VE KLİNİK BİLGİLER</th></tr>
                        <tr>
                            <th>4. Hasta Kodu</th>
                            <th>5. Yaş</th>
                            <th>6. Cinsiyet</th>
                            <th>7. Primer Tanı (ICD-10)</th>
                            <th>8. Primer Tanı "Diğer" ise belirtiniz</th>
                            <th>9. Sekonder Tanı Var mı?</th>
                            <th>10. Sekonder Tanı-1 (ICD-10)</th>
                            <th>11. Eş Zamanlı Psikotrop İlaç</th>
                            <th>12. İlaç-1 Dozu (mg/gün)</th>
                            <th>13. Eş Zamanlı Psikotrop İlaç-2 Adı</th>
                            <th>14. İlaç-2 Dozu (mg/gün)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" id="hasta_kodu" name="Hasta Kodu"></td>
                            <td><input type="number" id="yas" name="Yaş"></td>
                            <td><select id="cinsiyet" name="Cinsiyet"><option value="Kız">Kız</option><option value="Erkek">Erkek</option></select></td>
                            <td><input type="text" id="primer_tani" name="Primer Tanı" placeholder="örn: F90.0"></td>
                            <td><input type="text" id="primer_tani_diger" name="Primer Tanı (Diğer)"></td>
                            <td><select id="sekonder_tani_varmi" name="Sekonder Tanı Var mı?"><option value="Hayır">Hayır</option><option value="Evet">Evet</option></select></td>
                            <td><input type="text" id="sekonder_tani_1" name="Sekonder Tanı" placeholder="örn: F41.1"></td>
                            <td><input type="text" id="psikotrop_ilac_1" name="Eş Zamanlı İlaç 1"></td>
                            <td><input type="number" id="psikotrop_ilac_1_doz" name="Eş Zamanlı İlaç 1 Dozu"></td>
                            <td><input type="text" id="psikotrop_ilac_2" name="Eş Zamanlı İlaç 2"></td>
                            <td><input type="number" id="psikotrop_ilac_2_doz" name="Eş Zamanlı İlaç 2 Dozu"></td>
                        </tr>
                    </tbody>
                     
                    <!-- BÖLÜM 3: BENZODIAZEPİN TEDAVİ BİLGİLERİ -->
                    <thead>
                        <tr><th colspan="5" class="section-header">BÖLÜM 3: BENZODIAZEPİN TEDAVİ BİLGİLERİ</th></tr>
                        <tr>
                           <th>15. Kullanılan Benzodiazepin Adı</th>
                           <th>16. Formülasyon</th>
                           <th>17. Başlama Nedeni/Temel Şikayet</th>
                           <th>18. Tedavi Öncesi Semptom Şiddeti (CGI-S)</th>
                           <th>19. Günlük Ortalama Doz</th>
                        </tr>
                    </thead>
                     <tbody>
                        <tr>
                           <td><input type="text" id="bzd_adi" name="Benzodiazepin Adı" placeholder="Klonazepam, Alprazolam..."></td>
                           <td><select id="bzd_formulasyon" name="Formülasyon"><option value="Damla">Damla</option><option value="Tablet">Tablet</option></select></td>
                           <td class="checkbox-group">
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Yoğun anksiyete"> Yoğun anksiyete</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Panik atak"> Panik atak</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Uykusuzluk"> Uykusuzluk</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Ajitasyon"> Ajitasyon</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Davranışsal sorunlar"> Davranışsal sorunlar</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Tikler"> Tikler</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Prosedürel anksiyete"> Prosedürel anksiyete</label><br>
                                <label><input type="checkbox" name="baslama_nedeni[]" value="Diğer"> Diğer</label>
                           </td>
                           <td><input type="number" id="cgi_s" name="Tedavi Öncesi CGI-S" min="1" max="7"></td>
                           <td><input type="text" id="bzd_doz" name="BZD Ortalama Doz" placeholder="örn: 0.5 mg/gün veya 5 damla/gün"></td>
                        </tr>
                    </tbody>
                    <thead>
                        <tr>
                            <th>20. Doz Birimi</th>
                            <th>21. Toplam Kullanım Süresi (Gün olarak)</th>
                            <th colspan="3">22. Tedavi Sonrası Klinik İyileşme (CGI-I)</th>
                        </tr>
                    </thead>
                    <tbody>
                         <tr>
                            <td><select id="bzd_doz_birimi" name="BZD Doz Birimi"><option value="mg/gün">mg/gün</option><option value="damla/gün">damla/gün</option></select></td>
                            <td><input type="number" id="kullanim_suresi" name="Toplam Kullanım Süresi (Gün)"></td>
                            <td colspan="3"><input type="number" id="cgi_i" name="Tedavi Sonrası CGI-I" min="1" max="7"></td>
                        </tr>
                    </tbody>

                    <!-- BÖLÜM 4: UKU YAN ETKİ DEĞERLENDİRMESİ -->
                    <thead>
                        <tr><th colspan="2" class="section-header">BÖLÜM 4: UKU YAN ETKİ DEĞERLENDİRMESİ (0:Yok, 1:Hafif, 2:Orta, 3:Şiddetli, 9:Değerlendirilemedi)</th></tr>
                    </thead>
                    <tbody>
                        <tr><td class="sub-section-header">RUHSAL YAN ETKİLER</td><td class="sub-section-header">ŞİDDET</td></tr>
                        <tr><td>1.1 Konsantrasyon sorunları</td><td><input type="number" id="yanetki_1_1" name="YE: Konsantrasyon" min="0" max="9" value="9"></td></tr>
                        <tr><td>1.2 Kuvvetsizlik / Halsizlik / Kolay yorulma</td><td><input type="number" id="yanetki_1_2" name="YE: Halsizlik" min="0" max="9" value="9"></td></tr>
                        <tr><td>1.3 Uyku hali / Sedasyon</td><td><input type="number" id="yanetki_1_3" name="YE: Sedasyon" min="0" max="9" value="9"></td></tr>
                        <tr><td>1.4 Unutkanlık</td><td><input type="number" id="yanetki_1_4" name="YE: Unutkanlık" min="0" max="9" value="9"></td></tr>
                        <tr><td>1.5 Depresyon</td><td><input type="number" id="yanetki_1_5" name="YE: Depresyon" min="0" max="9" value="9"></td></tr>
                        <tr><td class="sub-section-header">NÖROLOJİK YAN ETKİLER</td><td class="sub-section-header">ŞİDDET</td></tr>
                        <tr><td>2.1 Distoni</td><td><input type="number" id="yanetki_2_1" name="YE: Distoni" min="0" max="9" value="9"></td></tr>
                        <tr><td>2.5 Tremor</td><td><input type="number" id="yanetki_2_5" name="YE: Tremor" min="0" max="9" value="9"></td></tr>
                        <tr><td class="sub-section-header">OTONOMİK YAN ETKİLER</td><td class="sub-section-header">ŞİDDET</td></tr>
                        <tr><td>3.3 Azalmış Salivasyon (Ağızda Kuruluk)</td><td><input type="number" id="yanetki_3_3" name="YE: Ağız Kuruluğu" min="0" max="9" value="9"></td></tr>
                        <tr><td>3.4 Bulantı / Kusma</td><td><input type="number" id="yanetki_3_4" name="YE: Bulantı/Kusma" min="0" max="9" value="9"></td></tr>
                        <tr><td class="sub-section-header">DİĞER YAN ETKİLER</td><td class="sub-section-header">ŞİDDET</td></tr>
                        <tr><td>4.5 Kilo Artışı</td><td><input type="number" id="yanetki_4_5" name="YE: Kilo Artışı" min="0" max="9" value="9"></td></tr>
                        <tr><td>4.17 Baş Ağrısı</td><td><input type="number" id="yanetki_4_17" name="YE: Baş Ağrısı" min="0" max="9" value="9"></td></tr>
                        <tr><td>4.19 Psikolojik Bağımlılık</td><td><input type="number" id="yanetki_4_19" name="YE: Psikolojik Bağımlılık" min="0" max="9" value="9"></td></tr>
                    </tbody>
                    
                    <!-- BÖLÜM 5: GENEL DEĞERLENDİRME -->
                    <thead>
                        <tr><th colspan="3" class="section-header">BÖLÜM 5: GENEL DEĞERLENDİRME</th></tr>
                        <tr>
                            <th>79. Yan Etkilerin Günlük Performansı Etkilemesi</th>
                            <th>80. Nedensel İlişki (Yan Etkinin İlaçla İlişkisi)</th>
                            <th>81. Ek Notlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><input type="text" id="performans_etkisi" name="Yan Etkilerin Performansa Etkisi"></td>
                            <td><input type="text" id="nedensel_iliski" name="Nedensel İlişki"></td>
                            <td><textarea id="ek_notlar" name="Ek Notlar" rows="3"></textarea></td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- BÖLÜM 6: EYLEMLER -->
            <div class="p-4 bg-gray-50 border-t flex items-center">
                <button id="generate-button" type="button" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300">
                    ✨ Yapay Zeka ile Klinik Özet Oluştur
                </button>
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition duration-300 ml-4">
                    📋 Formu Gönder
                </button>
            </div>
        </form> <!-- FORM BİTİŞİ -->
    </div>

    <!-- Yükleniyor Modalı -->
    <div id="loading-modal">
        <div class="modal-content text-center">
            <div class="loader"></div>
            <p class="mt-4 text-lg">Klinik özet oluşturuluyor, lütfen bekleyin...</p>
        </div>
    </div>

    <!-- Sonuç Modalı -->
    <div id="result-modal">
        <div class="modal-content">
            <h2 class="text-2xl font-bold mb-4">Oluşturulan Klinik Özet</h2>
            <div id="result-text" class="bg-gray-100 p-4 rounded-md whitespace-pre-wrap max-h-96 overflow-y-auto"></div>
            <button id="close-modal-button" class="mt-4 bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg">Kapat</button>
        </div>
    </div>

<script type="module">
    const generateButton = document.getElementById('generate-button');
    const loadingModal = document.getElementById('loading-modal');
    const resultModal = document.getElementById('result-modal');
    const closeModalButton = document.getElementById('close-modal-button');
    const resultText = document.getElementById('result-text');

    generateButton.addEventListener('click', async () => {
        loadingModal.style.display = 'block';

        const formData = {
            hasta_kodu: document.getElementById('hasta_kodu').value,
            yas: document.getElementById('yas').value,
            cinsiyet: document.getElementById('cinsiyet').value,
            primer_tani: document.getElementById('primer_tani').value,
            primer_tani_diger: document.getElementById('primer_tani_diger').value,
            sekonder_tani_1: document.getElementById('sekonder_tani_1').value,
            psikotrop_ilac_1: document.getElementById('psikotrop_ilac_1').value,
            psikotrop_ilac_1_doz: document.getElementById('psikotrop_ilac_1_doz').value,
            psikotrop_ilac_2: document.getElementById('psikotrop_ilac_2').value,
            psikotrop_ilac_2_doz: document.getElementById('psikotrop_ilac_2_doz').value,
            bzd_adi: document.getElementById('bzd_adi').value,
            bzd_formulasyon: document.getElementById('bzd_formulasyon').value,
            baslama_nedenleri: Array.from(document.querySelectorAll('input[name="baslama_nedeni[]"]:checked')).map(el => el.value).join(', ') || 'Belirtilmemiş',
            cgi_s: document.getElementById('cgi_s').value,
            bzd_doz: document.getElementById('bzd_doz').value,
            bzd_doz_birimi: document.getElementById('bzd_doz_birimi').value,
            kullanim_suresi: document.getElementById('kullanim_suresi').value,
            cgi_i: document.getElementById('cgi_i').value,
            yan_etkiler: [
                { ad: 'Konsantrasyon sorunları', deger: document.getElementById('yanetki_1_1').value },
                { ad: 'Kuvvetsizlik / Halsizlik', deger: document.getElementById('yanetki_1_2').value },
                { ad: 'Uyku hali / Sedasyon', deger: document.getElementById('yanetki_1_3').value },
                { ad: 'Unutkanlık', deger: document.getElementById('yanetki_1_4').value },
                { ad: 'Depresyon', deger: document.getElementById('yanetki_1_5').value },
                { ad: 'Distoni', deger: document.getElementById('yanetki_2_1').value },
                { ad: 'Tremor', deger: document.getElementById('yanetki_2_5').value },
                { ad: 'Ağızda Kuruluk', deger: document.getElementById('yanetki_3_3').value },
                { ad: 'Bulantı / Kusma', deger: document.getElementById('yanetki_3_4').value },
                { ad: 'Kilo Artışı', deger: document.getElementById('yanetki_4_5').value },
                { ad: 'Baş Ağrısı', deger: document.getElementById('yanetki_4_17').value },
                { ad: 'Psikolojik Bağımlılık', deger: document.getElementById('yanetki_4_19').value },
            ].filter(etki => etki.deger != '9' && etki.deger != '').map(etki => `${etki.ad} (Şiddet: ${etki.deger})`).join('\n') || 'Kayda değer yan etki bildirilmedi.',
            performans_etkisi: document.getElementById('performans_etkisi').value,
            nedensel_iliski: document.getElementById('nedensel_iliski').value,
            ek_notlar: document.getElementById('ek_notlar').value,
        };

        const systemPrompt = `You are an expert medical assistant in child and adolescent psychiatry. Your task is to generate a professional, concise, and well-structured clinical summary note in TURKISH based on the provided patient data. The note should be suitable for a patient's medical record. Structure the note with clear headings.`;
        const userQuery = `
            Lütfen aşağıdaki yapılandırılmış hasta verilerine dayanarak Türkçe dilinde profesyonel bir klinik özet notu oluşturun:

            - Hasta Kodu: ${formData.hasta_kodu || 'Belirtilmemiş'}
            - Yaş: ${formData.yas || 'Belirtilmemiş'}
            - Cinsiyet: ${formData.cinsiyet || 'Belirtilmemiş'}
            - Primer Tanı: ${formData.primer_tani || 'Belirtilmemiş'} ${formData.primer_tani_diger ? '(Diğer: ' + formData.primer_tani_diger + ')' : ''}
            - Sekonder Tanı: ${formData.sekonder_tani_1 || 'Yok'}
            - Eş Zamanlı Psikotrop Tedaviler:
                - ${formData.psikotrop_ilac_1 || 'Yok'} (${formData.psikotrop_ilac_1_doz || 'N/A'} mg/gün)
                - ${formData.psikotrop_ilac_2 || 'Yok'} (${formData.psikotrop_ilac_2_doz || 'N/A'} mg/gün)
            - Benzodiazepin Tedavisi:
                - İlaç: ${formData.bzd_adi || 'Belirtilmemiş'} (${formData.bzd_formulasyon || ''})
                - Başlama Nedeni: ${formData.baslama_nedenleri}
                - Tedavi Öncesi CGI-S: ${formData.cgi_s || 'Belirtilmemiş'}
                - Ortalama Doz: ${formData.bzd_doz || 'N/A'} ${formData.bzd_doz_birimi || ''}
                - Toplam Kullanım Süresi: ${formData.kullanim_suresi || 'N/A'} gün
                - Tedavi Sonrası CGI-I: ${formData.cgi_i || 'Belirtilmemiş'}
            - Gözlemlenen Yan Etkiler:
            ${formData.yan_etkiler}
            - Genel Değerlendirme:
                - Yan Etkilerin Performansa Etkisi: ${formData.performans_etkisi || 'Belirtilmemiş'}
                - Nedensellik: ${formData.nedensel_iliski || 'Belirtilmemiş'}
            - Ek Notlar: ${formData.ek_notlar || 'Yok'}
        `;

        try {
            const apiKey = "";
            const apiUrl = \`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${apiKey}\`;

            const payload = {
                contents: [{ parts: [{ text: userQuery }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] },
            };

            const response = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error(\`API isteği başarısız oldu: ${response.status}\`);
            }

            const result = await response.json();
            const candidate = result.candidates?.[0];

            if (candidate && candidate.content?.parts?.[0]?.text) {
                resultText.textContent = candidate.content.parts[0].text;
            } else {
                resultText.textContent = 'Yapay zekadan geçerli bir yanıt alınamadı. Lütfen tekrar deneyin.';
            }

        } catch (error) {
            console.error('Hata:', error);
            resultText.textContent = \`Bir hata oluştu: ${error.message}\`;
        } finally {
            loadingModal.style.display = 'none';
            resultModal.style.display = 'block';
        }
    });

    closeModalButton.addEventListener('click', () => {
        resultModal.style.display = 'none';
    });

    window.addEventListener('click', (event) => {
        if (event.target == resultModal) {
            resultModal.style.display = 'none';
        }
    });

</script>
</body>
</html>

